{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/frontend/:file*",
      "destination": "/frontend/:file*"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/login.js"
    },
    {
      "source": "/api/:file*",
      "destination": "/api/:file*"
    },
    {
      "source": "/js/:file*",
      "destination": "/:file*"
    },
    {
      "source": "/css/:file*",
      "destination": "/:file*"
    },
    {
      "source": "/assets/:file*",
      "destination": "/:file*"
    },
    {
      "source": "/logo/:file*",
      "destination": "/:file*"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ]
}
