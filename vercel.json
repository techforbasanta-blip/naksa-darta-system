{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin.html",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/js/:file*",
      "destination": "/frontend/js/:file*"
    },
    {
      "source": "/css/:file*",
      "destination": "/frontend/css/:file*"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/login.js"
    },
    {
      "source": "/api/:file*",
      "destination": "/api/:file*"
    }
  ]
}
