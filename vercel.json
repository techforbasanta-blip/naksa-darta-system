{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/logo/(.*)",
      "dest": "frontend/logo/$1"
    },
    {
      "src": "/darta.html",
      "dest": "frontend/darta.html"
    },
    {
      "src": "/record.html",
      "dest": "frontend/record.html"
    },
    {
      "src": "/verify.html",
      "dest": "frontend/verify.html"
    },
    {
      "src": "/login.html",
      "dest": "frontend/login.html"
    },
    {
      "src": "/",
      "dest": "frontend/login.html"
    }
  ]
}